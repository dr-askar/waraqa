 <application android:label="ورقة" android:icon="@drawable/ic_waraqa" android:roundIcon="@drawable/ic_waraqa" android:theme="@style/AppTheme" android:allowBackup="false" android:dataExtractionRules="@xml/data_extraction_rules" android:enableOnBackInvokedCallback="false" android:supportsRtl="true" android:usesCleartextTraffic="false">
